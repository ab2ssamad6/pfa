# Copy to .env (scripts/setup.sh does this) and adjust. All values have safe defaults.

# PostgreSQL
POSTGRES_USER=netad
POSTGRES_PASSWORD=netad
POSTGRES_DB=netad

# Host ports (bound to 127.0.0.1 only)
WEB_PORT=8080
API_PORT=8000
MOCK_PORT=8081
DB_PORT=5432

# Telemetry source. Default = bundled mock. For a real Zabbix 6.0/7.0 see docs/real_zabbix.md
ZABBIX_URL=http://mock-zabbix:8081/api_jsonrpc.php
ZABBIX_TOKEN=mock-zabbix-token

# Mock scenario (file in mock_zabbix/scenarios/) and how far in the past it starts (seconds)
MOCK_SCENARIO=defense_demo
MOCK_START_OFFSET_SECONDS=0
# Demo-only ground truth for the Model page; set empty to disable
DEMO_TRUTH_URL=http://mock-zabbix:8081/_scenario/truth

# Worker / incident rules
POLL_INTERVAL_SECONDS=2
INCIDENT_DEBOUNCE_K=3
INCIDENT_DEBOUNCE_N=5
INCIDENT_GAP_SECONDS=60
INCIDENT_RESOLVE_SECONDS=120
RETENTION_DAYS=7
LOG_LEVEL=INFO

# MLOps (scripts/mlops.sh, train.sh, promote.sh, dvc.sh). SeaweedFS = S3 store for DVC + MLflow artifacts.
S3_ACCESS_KEY=netad
S3_SECRET_KEY=netad-s3-secret
S3_PORT=8333
S3_CONSOLE_PORT=8888
MLFLOW_PORT=5050
MLFLOW_DB_PASSWORD=mlflow
MLFLOW_EXPERIMENT_NAME=netad-anomaly-detection
# MLflow tracking server. Leave empty for the local MLflow service (http://mlflow:5000, UI on MLFLOW_PORT).
# Free hosted alternative, DagsHub (token: dagshub.com > Settings > Tokens; never commit .env):
#   MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow
#   MLFLOW_TRACKING_USERNAME=<user>
#   MLFLOW_TRACKING_PASSWORD=<token>
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
